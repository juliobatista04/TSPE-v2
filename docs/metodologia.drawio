<mxfile host="app.diagrams.net" agent="tspe-v2">
  <diagram id="metodologia" name="Metodologia">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#F6F6F6">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t1" value="&lt;b&gt;&lt;font style='font-size:18px' color='#40005F'&gt;METODOLOGIA · TSPE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#4A3D5C'&gt;Classificação de risco de mortalidade hospitalar em Pernambuco (SIH/SUS)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="800" height="50" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;&lt;font color='#40005F'&gt;1. BASE DE DADOS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;SIH/SUS · TABNET (DATASUS)&lt;br&gt;Pernambuco · 12 CSVs brutos&lt;br&gt;&lt;b&gt;239 registros × 10 atributos&lt;/b&gt;&lt;br&gt;Alvo: alto_risco (tx. mortalidade &amp;gt; mediana 0.90%)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B3DB8;strokeWidth=2;fontColor=#1A1226;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="250" height="150" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;&lt;font color='#40005F'&gt;2. ANÁLISE DOS DADOS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ausentes ('-' = zero óbitos)&lt;br&gt;Duplicados · Outliers 1,5×IQR&lt;br&gt;Assimetria · Spearman&lt;br&gt;Gráfico de cada variável × alvo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B3DB8;strokeWidth=2;fontColor=#1A1226;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="250" height="150" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;&lt;font color='#40005F'&gt;3. SELEÇÃO DE VARIÁVEIS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Informação mútua&lt;br&gt;|ρ| Spearman com o alvo&lt;br&gt;Importância por permutação (RF)&lt;br&gt;Entra com 2 de 3 critérios&lt;br&gt;&lt;b&gt;Selecionadas:&lt;br&gt;tx_mort_melhor_hosp, media_permanencia&lt;br&gt;tx_mort_macro, faixa_etaria_ord&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B3DB8;strokeWidth=2;fontColor=#1A1226;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="250" height="150" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font color='#40005F'&gt;4. PRÉ-PROCESSAMENTO&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Limpeza TABNET · imputação (0 / mediana)&lt;br&gt;Outliers mantidos (grupos reais)&lt;br&gt;log1p(internações) · ordinal(idade)&lt;br&gt;One-hot(doença) · StandardScaler&lt;br&gt;Classes 50/50 · split 75/25 estratificado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B3DB8;strokeWidth=2;fontColor=#1A1226;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="80" width="250" height="150" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;&lt;font color='#40005F'&gt;5. MODELAGEM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Regressão Logística · KNN&lt;br&gt;Árvore de Decisão · Random Forest&lt;br&gt;SVM (RBF) · Gradient Boosting&lt;br&gt;Pipeline sklearn (pré + modelo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B3DB8;strokeWidth=2;fontColor=#1A1226;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="250" height="150" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;&lt;font color='#40005F'&gt;6. OTIMIZAÇÃO&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;GridSearchCV&lt;br&gt;StratifiedKFold (k=5)&lt;br&gt;Métrica: AUROC&lt;br&gt;&lt;b&gt;157 combinações testadas&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B3DB8;strokeWidth=2;fontColor=#1A1226;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="320" width="250" height="150" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font color='#B57BDB'&gt;7. AVALIAÇÃO&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;AUROC · F1 · Sensibilidade&lt;br&gt;Especificidade · Precisão · Acurácia&lt;br&gt;Matriz de confusão · Curva ROC&lt;br&gt;&lt;b&gt;Melhor: Random Forest · AUROC 0.951&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#40005F;strokeColor=#8B3DB8;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="250" height="150" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65148C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65148C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65148C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65148C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65148C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#65148C;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t2" value="Equipe: Julio César Batista Silva · Teves Gabriel · Luciano Filho · Jonathas Costa · Anderson Davi — WYD6399 · UniFavip Wyden · 2026" style="text;html=1;align=left;fontSize=10;fontColor=#4A3D5C;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1000" height="30" as="geometry"/></mxCell>
